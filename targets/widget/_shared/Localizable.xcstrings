      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The term start date needs a check. Set it in App first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学期开始日期还没设好，先去 App 检查一下吧"
