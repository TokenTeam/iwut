    "schedule.intent.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your classes, just a question away."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有什么课？问一下就知道～"
