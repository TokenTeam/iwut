    "prettier": "~3.9.6",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "expo-blur"
      ]
    },
    "install": {
      "exclude": []
