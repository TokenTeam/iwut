    "expo-font": "~58.0.1",
    "expo-haptics": "~58.0.1",
    "expo-image": "~58.0.2",
    "expo-image-picker": "~58.0.3",
    "expo-insights": "~58.0.3",
    "expo-linear-gradient": "~58.0.0",
    "expo-linking": "~58.0.3",
    "expo-localization": "~58.0.0",
    "expo-observe": "~58.0.5",
    "expo-router": "~58.0.4",
    "expo-secure-store": "~58.0.0",
    "expo-sharing": "~58.0.6",
    "expo-splash-screen": "~58.0.0",
    "expo-status-bar": "~58.0.0",
