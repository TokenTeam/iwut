+private fun Cursor.getIsPrimary(): Boolean {
+  // Some providers return the computed expression without the isPrimary alias.
+  val index = getColumnIndex(CalendarContract.Calendars.IS_PRIMARY).takeIf { it >= 0 }
+    ?: getColumnIndex(
+      "COALESCE(${CalendarContract.Calendars.IS_PRIMARY}, ${CalendarContract.Calendars.OWNER_ACCOUNT} = ${CalendarContract.Calendars.ACCOUNT_NAME})"
+    )
+  return index >= 0 && !isNull(index) && getInt(index) == 1
+}
