{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/TokenTeam/iwut/main/schemas/announcements.schema.json",
  "title": "Announcements",
  "description": "主页公告使用的远程配置，包含公告内容、展示条件和跳转信息。配置仓库位于 https://cnb.cool/TokenTeam/iwut-config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "announcements"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "integer",
      "description": "公告配置的协议版本号。只有发生不兼容的协议变更时才递增，客户端不会解析不支持的协议版本。",
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "配置文件的最后更新时间，使用 ISO 8601 格式和 UTC 时区。此字段用于排查 CDN 缓存，不参与公告展示判断。"
    },
    "announcements": {
      "type": "array",
      "description": "需要展示的公告列表。空数组表示当前没有公告。",
      "items": { "$ref": "#/definitions/announcement" }
    }
  },
  "definitions": {
    "announcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title"],
      "properties": {
        "id": {
          "type": "string",
          "description": "公告的唯一标识，只能使用小写字母、数字和连字符。客户端用它保存用户关闭公告的记录，发布后请勿修改。",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "description": "公告的类型，决定客户端展示的图标和强调色。",
          "enum": ["info", "warning", "event", "maintenance"]
        },
        "title": {
          "type": "string",
          "description": "公告的主标题。建议不超过 20 个汉字，避免在窄屏上被截断。",
          "minLength": 1,
          "maxLength": 40
        },
        "body": {
          "type": ["string", "null"],
          "description": "公告的正文或详细说明，可以省略。客户端默认显示单行摘要，用户点击公告卡片后可展开阅读全文。",
          "maxLength": 200
        },
        "link": {
          "description": "公告关联的跳转目标。省略或设为 null 时不提供跳转入口。",
          "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/link" }]
        },
        "startAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "公告开始展示的时间，使用 ISO 8601 格式。省略或设为 null 表示不限制开始时间。"
        },
        "endAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "公告停止展示的时间，使用 ISO 8601 格式。省略或设为 null 表示不限制结束时间。"
        },
        "priority": {
          "type": "integer",
          "description": "公告的展示优先级，默认为 0。多条公告同时生效时，数值越大的公告越靠前。",
          "minimum": 0,
          "maximum": 100,
          "default": 0
        },
        "dismissible": {
          "type": "boolean",
          "description": "是否允许用户手动关闭公告，默认为 true。重大维护公告建议设为 false。",
          "default": true
        },
        "minVersion": {
          "type": ["string", "null"],
          "description": "展示公告所需的最低应用版本，包含指定版本，例如 1.2.0。省略或设为 null 表示不限制最低版本。",
          "pattern": "^\\d+(\\.\\d+){0,2}$"
        },
        "maxVersion": {
          "type": ["string", "null"],
          "description": "允许展示公告的最高应用版本，包含指定版本，例如 2.0.0。省略或设为 null 表示不限制最高版本。",
          "pattern": "^\\d+(\\.\\d+){0,2}$"
        },
        "platforms": {
          "type": "array",
          "description": "允许展示公告的平台。省略或填写空数组时，公告适用于所有平台。",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ios", "android", "web"]
          }
        }
      }
    },
    "link": {
      "type": "object",
      "description": "公告关联的跳转信息。internal 表示通过 router.push 打开应用内页面，external 表示通过 Linking.openURL 打开外部链接。",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["kind", "url"],
          "properties": {
            "kind": { "const": "internal" },
            "url": {
              "type": "string",
              "description": "应用内页面的路由路径，必须以 / 开头，例如 /about 或 /wlan。",
              "pattern": "^/"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "url"],
          "properties": {
            "kind": { "const": "external" },
            "url": {
              "type": "string",
              "description": "外部链接地址，必须使用 HTTP 或 HTTPS 协议。",
              "format": "uri",
              "pattern": "^https?://"
            }
          }
        }
      ]
    }
  }
}
